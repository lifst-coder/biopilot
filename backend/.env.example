# Copy to backend/.env. All keys are optional.
BIOPILOT_DATABASE_URL=sqlite:///./biopilot.db
BIOPILOT_AUTO_SEED=true
# Seed scenario for an empty DB: reference (7 experiments, default) | lab (2 projects, 42 experiments)
BIOPILOT_SEED_PROFILE=reference
# Claude generation mode turns on only when this is set:
# ANTHROPIC_API_KEY=
BIOPILOT_CLAUDE_MODEL=claude-opus-5-5
BIOPILOT_CLAUDE_EFFORT=medium
# Force offline rules mode even if a key is present:
BIOPILOT_FORCE_RULES_MODE=false
# Browser origins allowed to call the API (comma-separated or JSON list). Default: Vite dev server only.
# BIOPILOT_CORS_ORIGINS=https://lab.example.org
# Request body caps (bytes) and JSON nesting depth — see SECURITY_REVIEW.md
# BIOPILOT_MAX_REQUEST_BYTES=33554432
# BIOPILOT_MAX_JSON_BYTES=12582912
# BIOPILOT_MAX_JSON_DEPTH=32
