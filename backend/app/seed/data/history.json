    {
      "id": "D01",
      "critique": "C01",
      "project": "residue",
      "experiment": "#006",
      "proposal": {
        "template_id": "calibration_weighting",
        "signature": "b6af1e625dcdc8a0fd94963108ef171b3aaa708b31405176a4f7962f091f8e63",
        "changes": [
          {
            "key": "calibration_weighting",
            "value": "1/x2"
          }
        ]
      },
      "action": "modify",
      "rationale": "무가중 대비 가중 적용은 타당하다. 다만 1/x와 1/x²의 역산 오차 합 차이가 작고 1/x²는 고농도 구간 가중이 지나치게 작아지므로 1/x를 다음 배치(#007)부터 적용한다.",
      "modifications": [
        {
          "key": "calibration_weighting",
          "value": "1/x"
        }
      ],
      "decided_by": "김연구",
      "followed_by": "#007"
    },
    {
      "id": "D02",
      "critique": "C02",
      "project": "residue",
      "experiment": "#009",
      "proposal": {
        "template_id": "factorial_pretreatment",
        "signature": "4d9eb29bbd54c15d5348e94d0590290fa3aeb0c1413dd31c4f45ae737b94f755",
        "changes": [
          {
            "key": "design",
            "value": "factorial 2x2"
          },
          {
            "key": "factor_extraction_solvent",
            "value": "아세토니트릴 | 메탄올"
          },
          {
            "key": "factor_sample_mass_g",
            "value": "15 | 10"
          }
        ]
      },
      "action": "reject",
      "reason": "workload",
      "rationale": "2×2 네 셀을 한 배치로 돌리면 시료 20개에 검량선까지 하루에 끝낼 수 없고, 6월은 이분석이 SOP v1.2 검증에 묶여 인력이 없다. 두 변경은 단일 변수 실험으로 하나씩 나눠 확인한다.",
      "decided_by": "김연구"
    },
    {
      "id": "D03",
      "critique": "C03",
      "project": "residue",
      "experiment": "#009",
      "proposal": {
        "template_id": "single_variable",
