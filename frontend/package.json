{
  "name": "biopilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts && git diff --exit-code -- src/api/schema.d.ts",
    "e2e": "playwright test",
    "demo:export": "cd ../backend && python -m app.scripts.export_scenario --profile reference && python -m app.scripts.export_scenario --profile lab",
    "dev:demo": "VITE_DEMO=true vite",
    "build:demo": "tsc -b && VITE_DEMO=true vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^5.0.5"
  }
}
